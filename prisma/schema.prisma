generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pgcrypto]
}

model PlatformSetting {
  id                          String  @id @default("default")
  currency                    String  @default("EGP")
  defaultCommissionRate       Int     @default(10)
  deliveryCommissionRate      Int     @default(20)
  defaultTaxRate              Int     @default(14)
  minOrderAmount              Int     @default(0)
  baseDeliveryFee             Int     @default(15)
  pricePerKm                  Int     @default(3)
  pricePerKmBicycle           Int     @default(2)
  pricePerKmMotorcycle        Int     @default(3)
  pricePerKmCar               Int     @default(5)
  pricePerKmVan               Int     @default(8)
  pricePerKmTruck             Int     @default(12)
  pricePerKmMotorTricycle     Int     @default(4)
  maxDeliveryFee              Int     @default(0)
  minDeliveryFeeBicycle       Int     @default(15)
  maxDeliveryFeeBicycle       Int     @default(0)
  minDeliveryFeeMotorcycle    Int     @default(15)
  maxDeliveryFeeMotorcycle    Int     @default(0)
  minDeliveryFeeCar           Int     @default(15)
  requireCustomerApproval     Boolean @default(true)
  customerApprovalTimeoutMins Int     @default(5)
  maxDeliveryFeeCar           Int     @default(0)
  minDeliveryFeeVan           Int     @default(15)
  maxDeliveryFeeVan           Int     @default(0)
  minDeliveryFeeTruck         Int     @default(15)
  maxDeliveryFeeTruck         Int     @default(0)
  minDeliveryFeeMotorTricycle Int     @default(15)
  maxDeliveryFeeMotorTricycle Int     @default(0)

  allowBicycle       Boolean @default(true)
  allowMotorcycle    Boolean @default(true)
  allowCar           Boolean @default(true)
  allowVan           Boolean @default(true)
  allowTruck         Boolean @default(true)
  allowMotorTricycle Boolean @default(true)

  minOrderKm                            Int       @default(0)
  minDistanceFixedPrice                 Int       @default(0)
  maxDeliveryRadiusKm                   Float     @default(1500)
  driverSearchRadiusKm                  Float     @default(5.0)
  driverSearchRadiusStepKm              Float     @default(2.0)
  driverSearchRadiusMaxKm               Float     @default(15.0)
  autoCancelPendingMins                 Int       @default(15)
  mobileWalletTimeoutMins               Int       @default(15)
  driverAcceptTimeoutSecs               Int       @default(30)
  isMaintenanceMode                     Boolean   @default(false)
  androidMinVersion                     String    @default("1.0.0")
  androidLatestVersion                  String    @default("1.0.0")
  androidForceUpdate                    Boolean   @default(false)
  androidStoreUrl                       String?
  iosMinVersion                         String    @default("1.0.0")
  iosLatestVersion                      String    @default("1.0.0")
  iosForceUpdate                        Boolean   @default(false)
  iosStoreUrl                           String?
  supportEmail                          String?
  supportPhone                          String?
  supportWhatsapp                       String?
  termsUrl                              String?
  privacyUrl                            String?
  homeCoverUrl                          String?
  motorcycleIconUrl                     String?
  carIconUrl                            String?
  deliveryBannerIconUrl                 String?
  retentionOrdersDays                   Int       @default(90)
  retentionArchivedChatsDays            Int       @default(60)
  retentionNotificationsDays            Int       @default(30)
  retentionExpiredSessionsDays          Int       @default(7)
  retentionAuditLogsDays                Int       @default(180)
  retentionAbandonedCartsDays           Int       @default(7)
  retentionWalletTransactionsDays       Int       @default(365)
  retentionStatisticsDays               Int       @default(365)
  maxKmForBicycle                       Float     @default(5.0)
  driverSearchMaxAttempts               Int       @default(5)
  fallbackOrderDistanceKm               Float     @default(3.0)
  customOrderPlatformFee                Int       @default(10)
  maxDispatchBatchSize                  Int       @default(300)
  coinValue                             Int       @default(1)
  amountSpentPerCoin                    Int       @default(10)
  minCoinsToUse                         Int       @default(1)
  driverBonusActive                     Boolean   @default(false)
  driverBonusAmount                     Int       @default(0)
  driverBonusStartDate                  DateTime? @db.Timestamptz(3)
  driverBonusEndDate                    DateTime? @db.Timestamptz(3)
  driverBonusPaidByCustomer             Boolean   @default(false)
  driverShiftsEnabled                   Boolean   @default(false)
  customerApprovalTimeoutSecs           Int       @default(60)
  maxActiveOrdersPerCustomer            Int       @default(2)
  requirePriorDeliveryForMultipleOrders Boolean   @default(true)
  maxOtpAttempts                        Int       @default(5)
  maxNegativeDriverBalance              Int       @default(500)
  otpExpirySeconds                      Int       @default(900)
  bronzeTierBonusPerKm                  Int       @default(0)
  silverTierBonusPerKm                  Int       @default(0)
  goldTierBonusPerKm                    Int       @default(0)
  highValueOrderThreshold               Int       @default(0)
  highValueUpfrontRate                  Int       @default(0)
  updatedAt                             DateTime  @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

model Zone {
  id                      String                  @id @default(uuid())
  name                    String
  nameAr                  String?
  boundary                Unsupported("geometry")
  isActive                Boolean                 @default(true)
  baseDeliveryFeeOverride Int?
  minOrderAmountOverride  Int?
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  driverShifts            DriverShift[]
  orders                  Order[]
  vendorBranches          VendorBranch[]
  shiftPools              ShiftPool[]

  @@index([isActive])
  @@index([boundary], type: Gist)
  @@map("zones")
}

model User {
  id                   String                    @id @default(uuid())
  email                String?                   @unique
  phone                String?                   @unique
  password             String?
  name                 String
  role                 Role                      @default(CUSTOMER)
  title                String?
  titleAr              String?
  permissions          Permission[]
  avatar               String?
  language             Language                  @default(EN)
  isEmailVerified      Boolean                   @default(false)
  isPhoneVerified      Boolean                   @default(false)
  isBanned             Boolean                   @default(false)
  banReason            String?
  autoReplyMessage     String?
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?                 @db.Timestamptz(3)
  auditLogs            AuditLog[]
  conversations        ConversationParticipant[]
  customer             Customer?
  devices              Device[]
  driver               Driver?
  messages             Message[]
  notificationSettings NotificationSetting?
  notifications        Notification[]
  sessions             Session[]
  assignedTickets      SupportTicket[]           @relation("TicketAssignee")
  createdTickets       SupportTicket[]           @relation("TicketCreator")
  vendorMemberships    VendorMember[]
  createdConversations Conversation[]            @relation("ConversationCreator")
  approvedTopUps       WalletTopUpRequest[]
  approvedDrivers      Driver[]                  @relation("DriverApprovals")
  accounts             Account[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Device {
  id         String         @id @default(uuid())
  token      String         @unique
  platform   DevicePlatform
  userId     String
  lastActive DateTime       @default(now()) @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@map("devices")
}

model Session {
  id        String     @id @default(uuid())
  userId    String
  hashedRt  String
  ipAddress String?
  userAgent String?
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  titleAr   String?
  body      String?
  bodyAr    String?
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("notifications")
}

model NotificationSetting {
  id            String   @id @default(uuid())
  userId        String   @unique
  pushEnabled   Boolean  @default(true)
  orderUpdates  Boolean  @default(true)
  chatMessages  Boolean  @default(true)
  promotions    Boolean  @default(true)
  system        Boolean  @default(true)
  ticketUpdates Boolean  @default(true)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(ORDER)
  orderId       String?
  order         Order?                    @relation(fields: [orderId], references: [id])
  status        ConversationStatus        @default(OPEN)
  vendorId      String?
  creatorId     String?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)
  participants  ConversationParticipant[]
  creator       User?                     @relation("ConversationCreator", fields: [creatorId], references: [id])
  vendor        Vendor?                   @relation(fields: [vendorId], references: [id])
  messages      Message[]
  supportTicket SupportTicket?

  @@index([orderId])
  @@index([vendorId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)
  lastReadAt     DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
  @@index([lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  text           String?
  mediaUrl       String?
  metadata       Json?
  replyToId      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model SupportTicket {
  id                 String         @id @default(uuid())
  ticketNumber       String         @unique @default(dbgenerated("'TKT-'::text || nextval('ticket_number_seq'::regclass)"))
  subject            String
  description        String?
  status             TicketStatus   @default(OPEN)
  category           TicketCategory @default(OTHER)
  subCategory        String?
  priority           TicketPriority @default(MEDIUM)
  creatorId          String
  assigneeId         String?
  orderId            String?
  vendorId           String?
  conversationId     String?        @unique
  lastStatusUpdateAt DateTime       @default(now()) @db.Timestamptz(3)
  escalatedAt        DateTime?      @db.Timestamptz(3)
  metadata           Json?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  assignee           User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  conversation       Conversation?  @relation(fields: [conversationId], references: [id])
  creator            User           @relation("TicketCreator", fields: [creatorId], references: [id])
  order              Order?         @relation(fields: [orderId], references: [id])
  vendor             Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([creatorId])
  @@index([assigneeId])
  @@index([vendorId])
  @@index([status])
  @@index([orderId])
  @@map("support_tickets")
}

model Customer {
  id               String                    @id @default(uuid())
  userId           String                    @unique
  canOrder         Boolean                   @default(true)
  deletedAt        DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  coinBalance      Int                       @default(0)
  addresses        Address[]
  carts            Cart[]
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteProducts FavoriteProduct[]
  favoriteVendors  FavoriteVendor[]
  orders           Order[]
  coinTransactions CustomerCoinTransaction[]
  orderReviews     OrderReview[]

  @@index([createdAt])
  @@index([deletedAt])
  @@map("customers")
}

enum CoinTransactionType {
  EARNED
  SPENT
  REFUNDED
}

model CustomerCoinTransaction {
  id           String              @id @default(uuid())
  customerId   String
  orderId      String?
  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@map("customer_coin_transactions")
}

model FavoriteVendor {
  id         String   @id @default(uuid())
  customerId String
  vendorId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@map("favorite_vendors")
}

model FavoriteProduct {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("favorite_products")
}

model Address {
  id         String                  @id @default(uuid())
  label      String                  @default("Home")
  address    String
  location   Unsupported("geometry")
  details    String?
  isDefault  Boolean                 @default(false)
  customerId String
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(3)
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([location], type: Gist)
  @@map("addresses")
}

model VendorVertical {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  slug      String   @unique
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  vendors   Vendor[]

  @@index([isActive, sortOrder])
  @@map("vendor_verticals")
}

model Vendor {
  id                 String                    @id @default(uuid())
  storeName          String
  storeNameAr        String?
  slug               String                    @unique
  description        String?
  descriptionAr      String?
  logo               String?
  coverImage         String?
  phone              String?
  taxId              String?
  rating             Float                     @default(0)
  ratingCount        Int                       @default(0)
  commissionRate     Int                       @default(10)
  status             VendorStatus              @default(CLOSED)
  walletBalance      Int                       @default(0)
  isContracted       Boolean                   @default(false)
  workingHours       Json?
  isScheduleActive   Boolean                   @default(true)
  is24Hours          Boolean                   @default(false)
  verticalId         String
  deletedAt          DateTime?                 @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  auditLogs          AuditLog[]
  carts              Cart[]
  conversations      Conversation[]
  favoritedBy        FavoriteVendor[]
  categories         MenuCategory[]
  orders             Order[]
  products           Product[]
  supportTickets     SupportTicket[]
  branches           VendorBranch[]
  members            VendorMember[]
  statistics         VendorStatistic[]
  walletTransactions VendorWalletTransaction[]
  promotions         Promotion[]
  offers             Offer[]
  orderReviews       OrderReview[]
  vertical           VendorVertical            @relation(fields: [verticalId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([verticalId])
  @@index([deletedAt])
  @@map("vendors")
}

model VendorMember {
  id        String           @id @default(uuid())
  vendorId  String
  userId    String
  role      VendorMemberRole @default(STAFF)
  branchId  String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch    VendorBranch?    @relation(fields: [branchId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([branchId])
  @@map("vendor_members")
}

model VendorBranch {
  id        String                  @id @default(uuid())
  name      String
  nameAr    String?
  address   String
  phone     String?
  isOpen    Boolean                 @default(true)
  location  Unsupported("geometry")
  vendorId  String
  zoneId    String
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)
  vendor    Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone      Zone                    @relation(fields: [zoneId], references: [id])

  vendorMembers VendorMember[]
  orders        Order[]

  @@index([zoneId])
  @@index([vendorId, isOpen])
  @@index([location], type: Gist)
  @@map("vendor_branches")
}

model VendorWalletTransaction {
  id           String                @id @default(uuid())
  vendorId     String
  orderId      String?
  type         VendorTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  referenceId  String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  order        Order?                @relation(fields: [orderId], references: [id])
  vendor       Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([orderId])
  @@index([createdAt])
  @@map("vendor_wallet_transactions")
}

model VendorStatistic {
  id              String          @id @default(uuid())
  vendorId        String
  period          StatisticPeriod
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  totalOrders     Int             @default(0)
  totalRevenue    Int             @default(0)
  totalCommission Int             @default(0)
  totalTax        Int             @default(0)
  completedOrders Int             @default(0)
  cancelledOrders Int             @default(0)
  avgPrepTimeMins Float?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, period, startDate])
  @@index([startDate, endDate])
  @@map("vendor_statistics")
}

model AppStatistic {
  id                String          @id @default(uuid())
  period            StatisticPeriod
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  totalOrders       Int             @default(0)
  totalAdminRevenue Int             @default(0)
  totalDeliveryFees Int             @default(0)
  activeCustomers   Int             @default(0)
  activeDrivers     Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([period, startDate])
  @@index([startDate, endDate])
  @@map("app_statistics")
}

model MenuCategory {
  id            String    @id @default(uuid())
  vendorId      String
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  iconUrl       String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([vendorId, isActive])
  @@map("menu_categories")
}

model Product {
  id               String               @id @default(uuid())
  version          Int                  @default(100)
  vendorId         String
  categoryId       String?
  name             String
  nameAr           String?
  description      String?
  descriptionAr    String?
  imageUrl         String?
  sellByStrip      Boolean              @default(false)
  stripsPerPackage Int?
  hasVariants      Boolean              @default(false)
  basePrice        Int?
  comparePrice     Int?
  sku              String?              @unique
  stock            Int?
  isActive         Boolean              @default(true)
  isFeatured       Boolean              @default(false)
  deletedAt        DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  cartItems        CartItem[]
  favoritedBy      FavoriteProduct[]
  orderItems       OrderItem[]
  optionGroups     ProductOptionGroup[]
  variants         ProductVariant[]
  promotions       Promotion[]
  offers           Offer[]
  category         MenuCategory?        @relation(fields: [categoryId], references: [id])
  vendor           Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, isActive, isFeatured])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id           String               @id @default(uuid())
  productId    String
  name         String
  nameAr       String?
  sku          String?              @unique
  basePrice    Int
  comparePrice Int?
  stock        Int?
  isActive     Boolean              @default(true)
  version      Int                  @default(100)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductOptionGroup {
  id         String          @id @default(uuid())
  productId  String?
  variantId  String?
  name       String
  nameAr     String?
  isRequired Boolean         @default(false)
  minSelect  Int             @default(0)
  maxSelect  Int             @default(100)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  options    ProductOption[]

  @@index([productId])
  @@index([variantId])
  @@map("product_option_groups")
}

model ProductOption {
  id               String             @id @default(uuid())
  groupId          String
  name             String
  nameAr           String?
  priceAdded       Int                @default(0)
  isActive         Boolean            @default(true)
  cartItemOptions  CartItemOption[]
  orderItemOptions OrderItemOption[]
  group            ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_options")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  vendorId   String
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  items      CartItem[]
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@index([customerId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id              String           @id @default(uuid())
  cartId          String
  productId       String?
  variantId       String?
  customName      String?
  customPrice     Int?
  customImageUrl  String?
  quantity        Int              @default(1)
  specialRequest  String?
  optionHash      String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  selectedOptions CartItemOption[]
  cart            Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model CartItemOption {
  id         String        @id @default(uuid())
  cartItemId String
  optionId   String
  cartItem   CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_options")
}

model Order {
  id                   String                    @id @default(uuid())
  orderNumber          String                    @unique @default(dbgenerated("'ORD-'::text || nextval('order_number_seq'::regclass)"))
  type                 OrderType                 @default(STANDARD)
  customerId           String
  vendorId             String?
  vendorBranchId       String?
  driverId             String?
  zoneId               String?
  driverShiftId        String?
  status               OrderStatus               @default(PENDING)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus             @default(PENDING)
  deliveryAddress      String
  deliveryLocation     Unsupported("geometry")
  pickupAddress        String?
  pickupLocation       Unsupported("geometry")?
  itemDetails          String?
  requestedVehicleType VehicleType?
  subtotal             Int
  deliveryFee          Int
  driverBonusFee       Int                       @default(0)
  serviceFee           Int
  tax                  Int
  discount             Int                       @default(0)
  coinsUsed            Int                       @default(0)
  coinsEarned          Int                       @default(0)
  grandTotal           Int
  upfrontAmount        Int                       @default(0)
  specialRequest       String?
  estimatedPrepTime    Int?
  distanceKm           Float?
  deletedAt            DateTime?                 @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  acceptedAt           DateTime?                 @db.Timestamptz(3)
  preparedAt           DateTime?                 @db.Timestamptz(3)
  driverAssignedAt     DateTime?                 @db.Timestamptz(3)
  pickedUpAt           DateTime?                 @db.Timestamptz(3)
  actualDeliveryTime   DateTime?                 @db.Timestamptz(3)
  driverTransactions   DriverWalletTransaction[]
  dispatches           OrderDispatch[]
  items                OrderItem[]
  statusEvents         OrderStatusEvent[]
  customer             Customer                  @relation(fields: [customerId], references: [id])
  driver               Driver?                   @relation(fields: [driverId], references: [id])
  driverShift          DriverShift?              @relation(fields: [driverShiftId], references: [id])
  vendor               Vendor?                   @relation(fields: [vendorId], references: [id])
  vendorBranch         VendorBranch?             @relation(fields: [vendorBranchId], references: [id])
  zone                 Zone?                     @relation(fields: [zoneId], references: [id])
  supportTickets       SupportTicket[]
  conversations        Conversation[]
  vendorTransactions   VendorWalletTransaction[]
  review               OrderReview?

  @@index([customerId])
  @@index([zoneId])
  @@index([vendorId, status])
  @@index([driverId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([deliveryLocation], type: Gist)
  @@map("orders")
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderItem {
  id              String            @id @default(uuid())
  orderId         String
  productId       String?
  variantId       String?
  productName     String
  variantName     String?
  unitPrice       Int
  quantity        Int
  totalPrice      Int
  specialRequest  String?
  selectedOptions OrderItemOption[]
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?          @relation(fields: [productId], references: [id])
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id          String         @id @default(uuid())
  orderItemId String
  optionId    String?
  optionName  String
  priceAdded  Int
  option      ProductOption? @relation(fields: [optionId], references: [id])
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_options")
}

model Driver {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  name                String
  avatar              String?
  nationalId          String?
  licenseNumber       String?
  vehicleType         VehicleType               @default(MOTORCYCLE)
  vehiclePlate        String?
  tier                DriverTier                @default(GOLD)
  status              DriverStatus              @default(OFFLINE)
  lastLocation        Unsupported("geometry")?
  lastLocationUpdate  DateTime?                 @db.Timestamptz(3)
  rating              Int                       @default(500)
  ratingCount         Int                       @default(0)
  totalOrders         Int                       @default(0)
  walletBalance       Int                       @default(0)
  hasUnpaidCommission Boolean                   @default(false)
  version             Int                       @default(100)
  deletedAt           DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  shifts              DriverShift[]
  statistics          DriverStatistic[]
  walletTransactions  DriverWalletTransaction[]
  mobileWallets       MobileWallet[]
  topUps              WalletTopUpRequest[]
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isApproved          Boolean                   @default(false)
  approvedAt          DateTime?                 @db.Timestamptz(3)
  approvedById        String?
  approvedBy          User?                     @relation("DriverApprovals", fields: [approvedById], references: [id])
  dispatches          OrderDispatch[]
  orders              Order[]
  orderReviews        OrderReview[]

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("drivers")
}

model DriverShift {
  id                 String                    @id @default(uuid())
  driverId           String
  shiftPoolId        String?
  zoneId             String?
  shiftDate          DateTime                  @db.Timestamptz(3)
  startTime          DateTime                  @db.Timestamptz(3)
  endTime            DateTime                  @db.Timestamptz(3)
  actualStart        DateTime?                 @db.Timestamptz(3)
  actualEnd          DateTime?                 @db.Timestamptz(3)
  startingLocation   Unsupported("geometry")?
  endingLocation     Unsupported("geometry")?
  status             DriverShiftStatus         @default(SCHEDULED)
  breakMinutes       Int?
  totalEarnings      Int?
  totalDeliveries    Int?
  expiredDispatches  Int                       @default(0)
  rejectedDispatches Int                       @default(0)
  warningSent        Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  driver             Driver                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shiftPool          ShiftPool?                @relation(fields: [shiftPoolId], references: [id])
  zone               Zone?                     @relation(fields: [zoneId], references: [id])
  walletTransactions DriverWalletTransaction[]
  dispatches         OrderDispatch[]
  orders             Order[]
  swapRequests       ShiftSwapRequest[]

  @@index([shiftPoolId])
  @@index([zoneId])
  @@index([driverId, status])
  @@index([shiftDate])
  @@index([status])
  @@index([startingLocation], type: Gist)
  @@index([endingLocation], type: Gist)
  @@map("driver_shifts")
}

model ShiftPool {
  id           String        @id @default(uuid())
  zoneId       String?
  shiftDate    DateTime      @db.Date
  startTime    DateTime      @db.Timestamptz(3)
  endTime      DateTime      @db.Timestamptz(3)
  maxDrivers   Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  zone         Zone?         @relation(fields: [zoneId], references: [id])
  driverShifts DriverShift[]

  @@index([shiftDate])
  @@index([zoneId])
  @@map("shift_pools")
}

model ShiftSwapRequest {
  id                String            @id @default(uuid())
  driverShiftId     String            @unique
  offeredByDriverId String
  status            SwapRequestStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  driverShift DriverShift @relation(fields: [driverShiftId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([offeredByDriverId])
  @@map("shift_swap_requests")
}

model DriverWalletTransaction {
  id            String                @id @default(uuid())
  driverId      String
  orderId       String?
  driverShiftId String?
  type          WalletTransactionType
  amount        Int
  balanceAfter  Int
  description   String?
  referenceId   String?
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  driver        Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverShift   DriverShift?          @relation(fields: [driverShiftId], references: [id])
  order         Order?                @relation(fields: [orderId], references: [id])

  @@index([driverId])
  @@index([orderId])
  @@index([createdAt])
  @@index([driverShiftId])
  @@map("driver_wallet_transactions")
}

model DriverStatistic {
  id                      String          @id @default(uuid())
  driverId                String
  period                  StatisticPeriod
  startDate               DateTime        @db.Date
  endDate                 DateTime        @db.Date
  totalOrders             Int             @default(0)
  totalEarnings           Int             @default(0)
  completedOrders         Int             @default(0)
  cancelledOrders         Int             @default(0)
  onlineHours             Float?
  totalDispatchesReceived Int             @default(0)
  dispatchesAccepted      Int             @default(0)
  dispatchesRejected      Int             @default(0)
  dispatchesExpired       Int             @default(0)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)
  driver                  Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, period, startDate])
  @@index([startDate, endDate])
  @@map("driver_statistics")
}

model OrderDispatch {
  id                String         @id @default(uuid())
  orderId           String
  driverId          String
  driverShiftId     String?
  type              OrderType      @default(STANDARD)
  status            DispatchStatus @default(PENDING)
  distanceKm        Float?
  estimatedEarnings Int?
  expiresAt         DateTime       @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  driver            Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverShift       DriverShift?   @relation(fields: [driverShiftId], references: [id])
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([driverId])
  @@index([driverShiftId])
  @@index([status])
  @@index([createdAt])
  @@map("order_dispatches")
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String
  vendorId   String?
  actionType AuditActionType @default(OTHER)
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  sessionId  String?
  user       User            @relation(fields: [userId], references: [id])
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  session    Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vendorId])
  @@index([actionType])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("audit_logs")
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

