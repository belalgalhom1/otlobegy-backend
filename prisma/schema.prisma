model Promotion {
  id            String        @id @default(uuid())
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  imageUrl      String
  type          PromotionType @default(BANNER)
  vendorId      String?
  productId     String?
  externalUrl   String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  startDate     DateTime?     @db.Timestamptz(3)
  endDate       DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  vendor        Vendor?       @relation(fields: [vendorId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([isActive, sortOrder])
  @@map("promotions")
}

model Offer {
  id            String    @id @default(uuid())
  productId     String
  vendorId      String
  originalPrice Int
  offerPrice    Int
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  startDate     DateTime? @db.Timestamptz(3)
  endDate       DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([isActive, sortOrder])
  @@map("product_offers")
}

enum PromotionType {
  BANNER
  VENDOR
  PRODUCT
  EXTERNAL_LINK
  POPUP
  NOTIFICATION
}

enum WalletType {
  VODAFONE
  ORANGE
  WE
  ETISALAT
  INSTAPAY
}

model MobileWallet {
  id         String     @id @default(uuid())
  number     String
  type       WalletType
  isActive   Boolean    @default(true)
  isPlatform Boolean    @default(false)
  driverId   String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  driver Driver?              @relation(fields: [driverId], references: [id])
  topUps WalletTopUpRequest[]

  @@index([driverId])
  @@map("mobile_wallets")
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletTopUpRequest {
  id               String      @id @default(uuid())
  driverId         String
  platformWalletId String
  amount           Int
  receiptUrl       String
  status           TopUpStatus @default(PENDING)
  approvedById     String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  driver         Driver       @relation(fields: [driverId], references: [id])
  platformWallet MobileWallet @relation(fields: [platformWalletId], references: [id])
  approvedBy     User?        @relation(fields: [approvedById], references: [id])

  @@index([driverId])
  @@index([platformWalletId])
  @@index([approvedById])
  @@map("wallet_top_up_requests")
}

model OrderReview {
  id           String   @id @default(uuid())
  orderId      String   @unique
  customerId   String
  vendorId     String?
  driverId     String?
  vendorRating Float?
  driverRating Float?
  comment      String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [userId])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [userId])

  @@index([vendorId])
  @@index([driverId])
  @@index([customerId])
  @@map("order_reviews")
}

model Account {
  id                String @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}
